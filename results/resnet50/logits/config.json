  "device": "cuda",
  "schema_version": 6,
  "setting": "logits",
  "feature_protocol": {
    "layer4": {
      "location": "layer4.output_after_residual_add_and_relu",
      "layout": "B,C,H,W",
      "observation_layout": "(B*H*W),C",
      "covariance": "centered_channel_covariance",
