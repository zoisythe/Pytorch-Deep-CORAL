      "loss_divisor": "4*C^2",
      "dimension": 2048,
      "spatial_shape_at_224": [
        7,
        7
      ]
    },
    "pooled": {
      "location": "layer4.spatial_mean",
      "layout": "B,D",
      "observation_layout": "B,D",
      "covariance": "centered_sample_gram",
      "covariance_divisor": "B-1",
      "loss_divisor": "4*D^2",
      "dimension": 2048
    },
    "logits": {
      "location": "fc.linear_output",
      "layout": "B,D",
      "observation_layout": "B,D",
      "covariance": "centered_sample_gram",
      "covariance_divisor": "B-1",
      "loss_divisor": "4*D^2",
      "dimension": "num_classes"
    }
  },
  "coral_reduction": "mean",
  "effective_coral_weights": {
    "layer4": 0.0,
    "pooled": 0.0,
    "logits": 0.5
  },
